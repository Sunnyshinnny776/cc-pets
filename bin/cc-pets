#!/bin/zsh
set -eu

SCRIPT_DIR="${0:A:h}"
PROJECT_DIR="${SCRIPT_DIR:h}"
PET_BIN="${PROJECT_DIR}/.build/release/cc-pets"
BUILD_APP="${PROJECT_DIR}/.build/release/CC Pets.app"
INSTALLED_APP="${CC_PETS_APPLICATIONS_DIR:-${HOME}/Applications}/CC Pets.app"
source "${PROJECT_DIR}/scripts/i18n.zsh"

# 只列面向用户的命令。--hook / --claude-usage / --provider-event / --render-* 等是
# hooks、statusline 和测试调用的内部入口，列出来只会让人误用。
print_usage() {
  print -r -- "$(cc_pets_t "Usage: cc-pets [command]

  cc-pets                    Start the pet (prefers the copy installed in ~/Applications)
  cc-pets install            Install or repair the shell / Claude Code / Codex integrations
  cc-pets uninstall          Remove the integrations and restore the status line
  cc-pets uninstall --purge  Also delete the app, app data and preferences (asks first; keeps pets and lines in ~/.cc-pets)
  cc-pets uninstall-app      Only delete ~/Applications/CC Pets.app
  cc-pets build              Rebuild
  cc-pets clean              Clear caches (quit the pet first)
  cc-pets doctor             Check the installation and integrations, with suggested fixes
  cc-pets paths [--json]     List where settings, caches and data live, and their sizes
  cc-pets pet <command>      Manage pet sprites; see cc-pets pet help
  cc-pets bridge <command>   CC Bridge cross-session messaging; see cc-pets bridge --help
  cc-pets --status           Print the current Codex quota
  cc-pets --history          Print quota history (JSON)
  cc-pets --foreground       Run the pet in the foreground (for debugging)
  cc-pets -v, --version      Show the version
  cc-pets -h, --help         Show this help

codex-with-pet / claude-with-pet start the pet along with the CLI.")"
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
  print_usage
  exit 0
fi

if [[ "${1:-}" == "install" ]]; then
  exec "${PROJECT_DIR}/scripts/install-shell-integration.sh"
fi

if [[ "${1:-}" == "pet" ]]; then
  shift
  exec node "${PROJECT_DIR}/scripts/pet-store.mjs" "$@"
fi

if [[ "${1:-}" == "bridge" ]]; then
  shift
  exec node "${PROJECT_DIR}/scripts/bridge/cli.mjs" "$@"
fi

if [[ "${1:-}" == "doctor" || "${1:-}" == "paths" ]]; then
  exec node "${PROJECT_DIR}/scripts/doctor.mjs" "$@"
fi

if [[ "${1:-}" == "uninstall" ]]; then
  shift
  # --purge / --yes 要传下去；原先这里吞掉了参数，README 里的 uninstall --purge 实际不生效。
  exec "${PROJECT_DIR}/scripts/uninstall-shell-integration.sh" "$@"
fi

if [[ "${1:-}" == "uninstall-app" ]]; then
  exec "${PROJECT_DIR}/scripts/uninstall-app.sh"
fi

if [[ "${1:-}" == "build" ]]; then
  exec "${PROJECT_DIR}/scripts/build.sh"
fi

if [[ "${1:-}" == "clean" ]]; then
  shift
  exec "${PET_BIN}" --clean "$@"
fi

if [[ ! -x "${PET_BIN}" || ! -d "${BUILD_APP}" ]]; then
  "${PROJECT_DIR}/scripts/build.sh" >/dev/null
fi

if [[ $# -eq 0 ]]; then
  PET_APP="${BUILD_APP}"
  if [[ -d "${INSTALLED_APP}" ]]; then
    PET_APP="${INSTALLED_APP}"
  fi
  # 桌宠是常驻进程，会一直带着这里的环境。CLAUDE_CONFIG_DIR 是会话级的（claude-nw
  # 之类的别名会设它），泄漏过去会让桌宠永久只统计"第一个拉起它的账号"。
  env -u CLAUDE_CONFIG_DIR open -g "${PET_APP}"
  exit 0
fi

if [[ "${1:-}" == "--foreground" ]]; then
  shift
  exec "${PET_BIN}" "$@"
fi

if [[ "${1:-}" == "provider-event" ]]; then
  shift
  exec "${PET_BIN}" --provider-event "$@"
fi

exec "${PET_BIN}" "$@"
