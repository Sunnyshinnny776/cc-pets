#!/bin/zsh
set -eu

SCRIPT_DIR="${0:A:h}"
PROJECT_DIR="${SCRIPT_DIR:h}"
source "${PROJECT_DIR}/scripts/i18n.zsh"
PET_BIN="${PROJECT_DIR}/.build/release/cc-pets"
BUILD_APP="${PROJECT_DIR}/.build/release/CC Pets.app"
INSTALLED_APP="${CC_PETS_APPLICATIONS_DIR:-${HOME}/Applications}/CC Pets.app"
REAL_CLAUDE="${CLAUDE_REAL_BIN:-}"
SELF="${0:A}"
SHIM_DIR="${CC_PETS_SHIM_DIR:-${HOME}/.cc-pets/shims}"
CLIENT_DIR="${${TMPDIR:-/tmp/}%/}/cc-pets-$(id -u)-clients"
CLIENT_FILE="${CLIENT_DIR}/$$"

# PATH 里有一个名为 claude 的 shim（软链到本脚本）。alias 区分大小写而 macOS 文件系统
# 不区分，所以 Claude / CLAUDE 这些写法只有 shim 拦得住。代价是不能再用 whence -p：
# 它拿回来的第一个 claude 就是 shim 自己，exec 下去就是无限递归。这里遍历全部候选，
# 跳过解析后指向本脚本的、以及落在 shim 目录里的（复制而非软链安装时的兜底）。
if [[ -z "${REAL_CLAUDE}" ]]; then
  typeset -a CANDIDATES
  CANDIDATES=(${(f)"$(whence -ap claude 2>/dev/null || true)"})
  for candidate in "${CANDIDATES[@]}"; do
    [[ -n "${candidate}" && -x "${candidate}" ]] || continue
    [[ "${candidate:A}" == "${SELF}" ]] && continue
    [[ "${candidate:A:h}" == "${SHIM_DIR:A}" ]] && continue
    REAL_CLAUDE="${candidate}"
    break
  done
fi
if [[ -z "${REAL_CLAUDE}" || ! -x "${REAL_CLAUDE}" ]]; then
  print -u2 "$(cc_pets_t "No executable Claude Code CLI found. Install claude, or set CLAUDE_REAL_BIN to its real path.")"
  exit 127
fi

if [[ ! -x "${PET_BIN}" || ! -d "${BUILD_APP}" ]]; then
  "${PROJECT_DIR}/scripts/build.sh" >/dev/null
fi

PET_APP="${BUILD_APP}"
if [[ -d "${INSTALLED_APP}" ]]; then
  PET_APP="${INSTALLED_APP}"
fi

# 固定 Agent 所在终端；后续所有 Hook 都会继承，用户中途切换应用也不会改错目标。
export CC_PETS_TERMINAL_TTY="${TTY:-}"
export CC_PETS_TERMINAL_PROGRAM="${TERM_PROGRAM:-}"
export CC_PETS_TERMINAL_SESSION="${TERM_SESSION_ID:-${ITERM_SESSION_ID:-}}"
export CC_PETS_TERMINAL_BUNDLE_ID="$("${PET_BIN}" --frontmost-bundle-id 2>/dev/null || true)"
# 从当前会话实际使用的 Home 解析已登记账号，让启动事件从第一帧就能归属到正确卡片。
CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"
CC_PETS_PROFILE_ID="$("${PET_BIN}" profile resolve --provider claude --home "${CLAUDE_HOME}" 2>/dev/null || true)"
if [[ -n "${CC_PETS_PROFILE_ID}" ]]; then
  export CC_PETS_PROFILE_ID
  CC_PETS_PROFILE_NAME="$("${PET_BIN}" profile resolve --provider claude --home "${CLAUDE_HOME}" --field name 2>/dev/null || true)"
  [[ -n "${CC_PETS_PROFILE_NAME}" ]] && export CC_PETS_PROFILE_NAME
fi

mkdir -p "${CLIENT_DIR}"
# 依次记录 provider、TTY、profileId；旧版两行文件仍可按 provider 级在线兼容。
printf '%s\n%s\n%s\n' 'Claude' "${CC_PETS_TERMINAL_TTY:t}" "${CC_PETS_PROFILE_ID:-}" > "${CLIENT_FILE}"

print -rn -- '{"schemaVersion":1,"provider":"Claude","state":"starting"}' | \
  "${PET_BIN}" --provider-event >/dev/null 2>&1 || true
# 桌宠是常驻进程，会一直带着这里的环境。CLAUDE_CONFIG_DIR 是会话级的（claude-nw
# 之类的别名会设它），泄漏过去会让桌宠永久只统计"第一个拉起它的账号"。
env -u CLAUDE_CONFIG_DIR open -g "${PET_APP}" --args --managed
exec "${REAL_CLAUDE}" "$@"
