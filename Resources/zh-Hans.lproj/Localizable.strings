"Renamed {previous} to {session}." = "已从 {previous} 改名为 {session}。";
"Unknown command: {command}\n\n{USAGE}" = "未知命令：{command}\n\n{USAGE}";
"Missing recipient. Call list_agents first to see available session names." = "缺少收件人。先调用 list_agents 查看可用的会话名。";
